{
  "name": "owkr-match",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "imports": {
    "#domain/balance": "./domains/balance/shared/public.ts",
    "#domain/player": "./domains/player/shared/public.ts",
    "#domain/scrim": "./domains/scrim/shared/public.ts",
    "#domain/scrim/rules": "./domains/scrim/shared/rules.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "dotenv -e .env.local -- vercel dev",
    "dev:local": "dotenv -e .env.local -v NODE_ENV=development -v OWKR_LOCAL_AUTH_BYPASS=true -- vercel dev --local",
    "dev:local-only": "dotenv -e .env.example -v NODE_ENV=development -v OWKR_LOCAL_AUTH_BYPASS=true -v OWKR_LOCAL_DATA_ONLY=true -- vercel dev --local",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "boundaries": "boundra check-boundaries --root . --format json",
    "domains:graph": "boundra graph-domains --root . --format mermaid",
    "check": "npm run typecheck && npm run lint && npm run test && npm run boundaries && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "@vercel/node": "^5.8.27",
    "boundra": "0.2.2",
    "cookie": "^2.0.1",
    "framer-motion": "^12.26.2",
    "html-to-image": "^1.11.13",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vercel": "^58.9.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
