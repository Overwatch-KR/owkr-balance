{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "src/*": ["./src/*"],
      "@application/*": ["./src/application/*"],
      "@presentation/*": ["./src/components/*"],
      "#domain/balance": ["./domains/balance/shared/public.ts"],
      "#domain/player": ["./domains/player/shared/public.ts"],
      "#domain/scrim": ["./domains/scrim/shared/public.ts"],
      "#domain/scrim/rules": ["./domains/scrim/shared/rules.ts"]
    }
  },
  "include": ["src", "api", "vite.config.ts", "tailwind.config.js", "postcss.config.js"],
  "exclude": ["node_modules", "dist"]
}
