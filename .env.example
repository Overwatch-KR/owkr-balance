APP_ORIGIN=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
JWT_SECRET=
# Redis: Vercel/Upstash 연동에서 제공된 REST URL과 읽기/쓰기 토큰을 입력합니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash 이름을 사용할 경우 위 KV 변수 대신 아래 두 줄을 활성화합니다.
# UPSTASH 변수가 우선하므로, KV 사용 시 아래 변수를 빈 값으로 활성화하지 마세요.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN, KV_URL, REDIS_URL은 앱에서 사용하지 않습니다.

OWKR_LOCAL_DATA_ONLY=
VITE_ENABLE_REALTIME_DRAFT=false
DRAFT_REALTIME_URL=
DRAFT_ADMIN_PRIVATE_KEY=
DRAFT_BRIDGE_SECRET=

# Production backend: https://civilwar.devbot.me
# Paste the entire RSA private PEM with real line breaks in Vercel.
# DRAFT_BRIDGE_SECRET must match the realtime server; never use a VITE_ prefix.
